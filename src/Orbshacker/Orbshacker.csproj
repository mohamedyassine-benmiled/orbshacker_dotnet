<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>orbshacker</AssemblyName>
    <RootNamespace>Orbshacker</RootNamespace>
    <Version>0.0.0</Version>
    <!-- Normal build/run output remains framework-dependent. Release publishing
         explicitly enables the self-contained single-file options in CI. -->
    <SelfContained>false</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
